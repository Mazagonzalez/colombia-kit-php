{
    "name": "colombia-kit/colombia-kit",
    "description": "Utilidades para datos colombianos en PHP: NIT con dígito de verificación, departamentos y municipios DIVIPOLA del DANE y parser de direcciones. Sin dependencias.",
    "type": "library",
    "keywords": ["colombia", "nit", "dian", "digito-de-verificacion", "divipola", "dane", "municipios", "departamentos", "direcciones"],
    "homepage": "https://github.com/Mazagonzalez/colombia-kit/tree/main/php#readme",
    "license": "(MIT and CC-BY-SA-4.0)",
    "support": {
        "issues": "https://github.com/Mazagonzalez/colombia-kit/issues",
        "source": "https://github.com/Mazagonzalez/colombia-kit"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "laravel/framework": "Para usar las reglas de validación y los mensajes en español (Laravel 11 o superior)."
    },
    "autoload": {
        "psr-4": {
            "ColombiaKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ColombiaKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ColombiaKit\\Laravel\\ColombiaKitServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "analizar": "phpstan analyse --memory-limit=512M",
        "formato": "pint",
        "formato:verificar": "pint --test",
        "sin-extensiones": "@php -n tests/sin-extensiones.php",
        "verificar": [
            "@formato:verificar",
            "@analizar",
            "@test",
            "@sin-extensiones"
        ]
    }
}
